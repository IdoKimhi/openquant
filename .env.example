# Alpaca Paper Trading Bot - Environment Variables
# Copy this file to .env and fill in your values

# REQUIRED: Encryption key for API credentials (32-byte base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# REQUIRED: Bcrypt hash of your login password
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
APP_PASSWORD_HASH=

# Database URL (SQLite on named volume)
DATABASE_URL=sqlite:///data/bot.db

# Alpaca API base URL - HARDCODED TO PAPER TRADING ONLY
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Bot schedule cron expression (APScheduler format)
# Default: every 5 minutes during US market hours (9:30-16:00 ET, Mon-Fri)
BOT_SCHEDULE_CRON=*/5 9-16 * * MON-FRI

# JWT settings for auth tokens
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24